    </location>
    <location id="ReaderTask1_ReaderTask1cool1">
      <name>cool1</name>
    </location>
    <init ref="ReaderTask1_ReaderTask1idle"/>
    <transition>
      <source ref="ReaderTask1_ReaderTask1idle"/>
      <target ref="ReaderTask1_ReaderTask1release"/>
      <label kind="guard">x &gt;= 1 &amp;&amp; x &lt;= 1</label>
      <label kind="assignment">x = 0</label>
    </transition>
    <transition>
      <source ref="ReaderTask1_ReaderTask1release"/>
      <target ref="ReaderTask1_ReaderTask1prep1"/>
      <label kind="guard">x &gt;= 2 &amp;&amp; x &lt;= 3</label>
      <label kind="assignment">x = 0</label>
    </transition>
    <transition>
      <source ref="ReaderTask1_ReaderTask1prep1"/>
      <target ref="ReaderTask1_ReaderTask1ready"/>
      <label kind="guard">x &gt;= 2 &amp;&amp; x &lt;= 3</label>
      <label kind="assignment">x = 0</label>
    </transition>
    <transition>
      <source ref="ReaderTask1_ReaderTask1ready"/>
      <target ref="ReaderTask1_ReaderTask1granted"/>
      <label kind="synchronisation">grant_r1?</label>
      <label kind="assignment">x = 0</label>
    </transition>
    <transition>
      <source ref="ReaderTask1_ReaderTask1granted"/>
      <target ref="ReaderTask1_ReaderTask1emit"/>
      <label kind="synchronisation">read1!</label>
      <label kind="guard">x &gt;= 1 &amp;&amp; x &lt;= 1</label>
      <label kind="assignment">x = 0</label>
    </transition>
    <transition>
      <source ref="ReaderTask1_ReaderTask1emit"/>
      <target ref="ReaderTask1_ReaderTask1cool1"/>
      <label kind="synchronisation">done_r1!</label>
      <label kind="assignment">x = 0</label>
    </transition>
    <transition>
      <source ref="ReaderTask1_ReaderTask1cool1"/>
      <target ref="ReaderTask1_ReaderTask1idle"/>
      <label kind="guard">x &gt;= 3 &amp;&amp; x &lt;= 4</label>
      <label kind="assignment">x = 0</label>
    </transition>
  </template>
  <template>
    <name>Dispatcher</name>
    <declaration>clock d;
</declaration>    <location id="Dispatcher_Dispatchers0">      <name>s0</name>
    </location>
    <location id="Dispatcher_Dispatchers1">
      <name>s1</name>
    </location>
    <location id="Dispatcher_Dispatchers2">
      <name>s2</name>
    </location>
    <location id="Dispatcher_Dispatchers3">
      <name>s3</name>
    </location>
    <location id="Dispatcher_Dispatcherw0">
      <name>w0</name>
    </location>
    <location id="Dispatcher_Dispatcherw1">
      <name>w1</name>
    </location>
    <location id="Dispatcher_Dispatcherw2">
      <name>w2</name>
    </location>
    <location id="Dispatcher_Dispatcherw3">
      <name>w3</name>
    </location>
    <init ref="Dispatcher_Dispatchers0"/>
    <transition>
      <source ref="Dispatcher_Dispatchers0"/>
      <target ref="Dispatcher_Dispatcherw0"/>
      <label kind="synchronisation">grant_w1!</label>
      <label kind="guard">d &gt;= 2</label>
      <label kind="assignment">d = 0</label>
    </transition>
    <transition>
      <source ref="Dispatcher_Dispatcherw0"/>
      <target ref="Dispatcher_Dispatchers1"/>
      <label kind="synchronisation">done_w1?</label>
      <label kind="assignment">d = 0</label>
    </transition>
    <transition>
      <source ref="Dispatcher_Dispatchers1"/>
      <target ref="Dispatcher_Dispatcherw1"/>
      <label kind="synchronisation">grant_r1!</label>
      <label kind="guard">d &gt;= 1</label>
      <label kind="assignment">d = 0</label>
    </transition>
    <transition>
      <source ref="Dispatcher_Dispatcherw1"/>
      <target ref="Dispatcher_Dispatchers2"/>
      <label kind="synchronisation">done_r1?</label>
      <label kind="assignment">d = 0</label>
    </transition>
    <transition>
      <source ref="Dispatcher_Dispatchers2"/>
      <target ref="Dispatcher_Dispatcherw2"/>
      <label kind="synchronisation">grant_w1!</label>
      <label kind="guard">d &gt;= 2</label>
      <label kind="assignment">d = 0</label>
    </transition>
    <transition>
      <source ref="Dispatcher_Dispatcherw2"/>
      <target ref="Dispatcher_Dispatchers3"/>
      <label kind="synchronisation">done_w1?</label>
      <label kind="assignment">d = 0</label>
    </transition>
    <transition>
      <source ref="Dispatcher_Dispatchers3"/>
      <target ref="Dispatcher_Dispatcherw3"/>
      <label kind="synchronisation">grant_r1!</label>
      <label kind="guard">d &gt;= 1</label>
      <label kind="assignment">d = 0</label>
    </transition>
    <transition>
      <source ref="Dispatcher_Dispatcherw3"/>
      <target ref="Dispatcher_Dispatchers0"/>
      <label kind="synchronisation">done_r1?</label>
      <label kind="assignment">d = 0</label>
    </transition>
  </template>
  <system>system Buf,WriterTask1,ReaderTask1,Dispatcher;</system>
</nta>
