<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE nta PUBLIC "-//Uppaal Team//DTD Flat System 1.1//EN" "http://www.it.uu.se/research/group/darts/uppaal/flat-1_1.dtd">

<nta>
  <declaration>chan write1,read1,grant_w1,done_w1,grant_r1,done_r1;
</declaration>  <template>    <name>Buf</name>
    <declaration>clock x;
int count=0,len=2;
</declaration>    <location id="Buf_Bufq0">      <name>q0</name>
    </location>
    <init ref="Buf_Bufq0"/>
    <transition>
      <source ref="Buf_Bufq0"/>
      <target ref="Buf_Bufq0"/>
      <label kind="synchronisation">write1?</label>
      <label kind="guard">count &lt;= len</label>
      <label kind="assignment">count = count + 1,x = 0</label>
    </transition>
    <transition>
      <source ref="Buf_Bufq0"/>
      <target ref="Buf_Bufq0"/>
      <label kind="synchronisation">read1?</label>
      <label kind="guard">count &gt; 0</label>
      <label kind="assignment">count = count - 1,x = 0</label>
    </transition>
  </template>
  <template>
    <name>WriterTask1</name>
    <declaration>clock x;
</declaration>    <location id="WriterTask1_WriterTask1idle">      <name>idle</name>
    </location>
    <location id="WriterTask1_WriterTask1release">
      <name>release</name>
    </location>
    <location id="WriterTask1_WriterTask1ready">
      <name>ready</name>
    </location>
    <location id="WriterTask1_WriterTask1granted">
      <name>granted</name>
    </location>
    <location id="WriterTask1_WriterTask1emit">
      <name>emit</name>
    </location>
    <location id="WriterTask1_WriterTask1prep1">
      <name>prep1</name>
    </location>
    <location id="WriterTask1_WriterTask1cool1">
      <name>cool1</name>
    </location>
    <init ref="WriterTask1_WriterTask1idle"/>
    <transition>
      <source ref="WriterTask1_WriterTask1idle"/>
      <target ref="WriterTask1_WriterTask1release"/>
      <label kind="guard">x &gt;= 1 &amp;&amp; x &lt;= 1</label>
      <label kind="assignment">x = 0</label>
    </transition>
    <transition>
      <source ref="WriterTask1_WriterTask1release"/>
      <target ref="WriterTask1_WriterTask1prep1"/>
      <label kind="guard">x &gt;= 2 &amp;&amp; x &lt;= 3</label>
      <label kind="assignment">x = 0</label>
    </transition>
    <transition>
      <source ref="WriterTask1_WriterTask1prep1"/>
      <target ref="WriterTask1_WriterTask1ready"/>
      <label kind="guard">x &gt;= 2 &amp;&amp; x &lt;= 3</label>
      <label kind="assignment">x = 0</label>
    </transition>
    <transition>
      <source ref="WriterTask1_WriterTask1ready"/>
      <target ref="WriterTask1_WriterTask1granted"/>
      <label kind="synchronisation">grant_w1?</label>
      <label kind="assignment">x = 0</label>
    </transition>
    <transition>
      <source ref="WriterTask1_WriterTask1granted"/>
      <target ref="WriterTask1_WriterTask1emit"/>
      <label kind="synchronisation">write1!</label>
      <label kind="guard">x &gt;= 1 &amp;&amp; x &lt;= 1</label>
      <label kind="assignment">x = 0</label>
    </transition>
    <transition>
      <source ref="WriterTask1_WriterTask1emit"/>
      <target ref="WriterTask1_WriterTask1cool1"/>
      <label kind="synchronisation">done_w1!</label>
      <label kind="assignment">x = 0</label>
    </transition>
    <transition>
      <source ref="WriterTask1_WriterTask1cool1"/>
      <target ref="WriterTask1_WriterTask1idle"/>
      <label kind="guard">x &gt;= 3 &amp;&amp; x &lt;= 4</label>
      <label kind="assignment">x = 0</label>
    </transition>
  </template>
  <template>
    <name>ReaderTask1</name>
    <declaration>clock x;
</declaration>    <location id="ReaderTask1_ReaderTask1idle">      <name>idle</name>
    </location>
    <location id="ReaderTask1_ReaderTask1release">
      <name>release</name>
    </location>
    <location id="ReaderTask1_ReaderTask1ready">
      <name>ready</name>
    </location>
    <location id="ReaderTask1_ReaderTask1granted">
