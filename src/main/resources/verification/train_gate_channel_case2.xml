  <template>
    <name>Queue</name>
    <declaration>int[0,N] list[N],len=0,i=0;
</declaration>    <location id="Queue_QueueStart">      <name>Start</name>
    </location>
    <location id="Queue_QueueShiftdown">
      <name>Shiftdown</name>
      <committed/>
    </location>
    <init ref="Queue_QueueStart"/>
    <transition>
      <source ref="Queue_QueueStart"/>
      <target ref="Queue_QueueStart"/>
      <label kind="synchronisation">empty!</label>
      <label kind="guard">len==0</label>
    </transition>
    <transition>
      <source ref="Queue_QueueStart"/>
      <target ref="Queue_QueueStart"/>
      <label kind="synchronisation">notempty!</label>
      <label kind="guard">len&gt;0</label>
    </transition>
    <transition>
      <source ref="Queue_QueueStart"/>
      <target ref="Queue_QueueStart"/>
      <label kind="synchronisation">add?</label>
      <label kind="guard">len &lt; N</label>
      <label kind="assignment">list[len]=el,len=len+1</label>
    </transition>
    <transition>
      <source ref="Queue_QueueStart"/>
      <target ref="Queue_QueueStart"/>
      <label kind="synchronisation">hd?</label>
      <label kind="assignment">el=list[0]</label>
    </transition>
    <transition>
      <source ref="Queue_QueueStart"/>
      <target ref="Queue_QueueShiftdown"/>
      <label kind="synchronisation">rem!</label>
      <label kind="guard">len&gt;=1</label>
      <label kind="assignment">len=len-1,i=0</label>
    </transition>
    <transition>
      <source ref="Queue_QueueShiftdown"/>
      <target ref="Queue_QueueShiftdown"/>
      <label kind="guard">i&lt;len</label>
      <label kind="assignment">list[i]=list[i+1],i=i+1</label>
    </transition>
    <transition>
      <source ref="Queue_QueueShiftdown"/>
      <target ref="Queue_QueueStart"/>
      <label kind="guard">len==i</label>
      <label kind="assignment">list[i]=0,i=0</label>
    </transition>
  </template>
